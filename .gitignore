# build output
bin/
obj/
*.dll
*.pdb
# reference libraries: these come from MelonLoader, the loader package and the game, and are not ours to publish
refs/
refs-android/
# never publish: the game, anything made from it, your signing key, logs
*.xapk
*.apks
*.apk
!releases/patcher/*.apk
archive/pc-patcher/game-files/*
!archive/pc-patcher/game-files/.gitkeep
archive/pc-patcher/patched/
archive/pc-patcher/work-temp/
archive/pc-patcher/patch-log.txt
archive/pc-patcher/phone-logs/
archive/pc-patcher/phone-logs.zip
archive/pc-patcher/uninstall-backup/
archive/pc-patcher/tool/signing-key.pem
archive/pc-patcher/tool/platform-tools/
archive/pc-patcher/tool/ffmpeg/
# downloaded by "1 - patch.bat" (archive/pc-patcher/tool/get-tools.ps1), and joined from those pieces on every run
archive/pc-patcher/tool/*.part*
archive/pc-patcher/tool/*.download
archive/pc-patcher/tool/LemonPatch.exe
archive/pc-patcher/tool/melon_data.zip
# editor files
.vs/
.vscode/
*.user
# mod signing keys: never commit (tools/mod-signing)
*signing-key*.txt
